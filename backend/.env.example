# ─── AI Bhoomi — Backend Environment Configuration Example ───────────────────
# Copy this file to backend/.env for local development.
# NEVER commit real .env files with credentials to Git.
#
# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (Local development default):
DATABASE_URL=sqlite+aiosqlite:///./aibhoomi.db
# PostgreSQL (Docker/Production):
# DATABASE_URL=postgresql+asyncpg://aibhoomi:aibhoomi_dev@localhost:5432/aibhoomi
# SYNC_DATABASE_URL=postgresql://aibhoomi:aibhoomi_dev@localhost:5432/aibhoomi

# ── JWT Authentication ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ── Google Gemini AI (Backend Only) ──────────────────────────────────────────
# Obtain your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Earth Engine (Optional - leave default for demo mode) ─────────────
GEE_DEMO_MODE=true
# GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GEE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account-key.json
# GEE_PROJECT_ID=your-gcp-project-id

# ── SoilGrids ────────────────────────────────────────────────────────────────
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0

# ── Rate Limiting & Storage ──────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

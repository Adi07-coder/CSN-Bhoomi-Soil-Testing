# ─── AI Bhoomi — Frontend Environment Configuration Example ──────────────────
# Copy this file to .env.local for local development.
# NEVER commit .env.local to Git.
# This file contains ONLY placeholders — it is safe to commit.
#
# IMPORTANT: Variables prefixed with VITE_ are embedded in the browser bundle
# and are publicly visible. NEVER put API keys or backend secrets here.

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production — configured in Netlify's Environment Variables UI:
VITE_API_BASE_URL=https://csn-bhoomi-soil-testing.onrender.com


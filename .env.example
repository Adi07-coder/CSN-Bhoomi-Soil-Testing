# ─── AI Bhoomi — Root Environment Configuration Example ─────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# This file contains ONLY placeholders — it is safe to commit.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
DEBUG=true

# ── Database (PostgreSQL + PostGIS for production) ────────────────────────────
# Local development with SQLite:
DATABASE_URL=sqlite+aiosqlite:///./aibhoomi.db
# Local development with PostgreSQL (Docker Compose):
# DATABASE_URL=postgresql+asyncpg://aibhoomi:aibhoomi_dev@localhost:5432/aibhoomi
# SYNC_DATABASE_URL=postgresql://aibhoomi:aibhoomi_dev@localhost:5432/aibhoomi
# Production (Render / Supabase / Neon — set via hosting environment variables):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS — add your Netlify domain here before deploying ─────────────────────
# Local:
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
# Production (replace with your actual Netlify URL):
# BACKEND_CORS_ORIGINS=["https://your-app-name.netlify.app","http://localhost:5173"]

# ── Gemini AI (Backend Only — NEVER put this in a VITE_ variable) ─────────────
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Earth Engine (optional — leave blank for demo mode) ────────────────
# GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GEE_SERVICE_ACCOUNT_KEY_FILE=/path/to/service-account-key.json
# GEE_PROJECT_ID=your-gcp-project-id
GEE_DEMO_MODE=true

# ── SoilGrids (optional REST API, no key needed for basic queries) ────────────
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── File storage (local development) ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
